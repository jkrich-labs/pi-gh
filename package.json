{
  "name": "pi-gh",
  "version": "0.1.0",
  "description": "Compact GitHub tools for the pi coding agent via the authenticated gh CLI",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "github",
    "gh",
    "extension"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/gh"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "24.10.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
